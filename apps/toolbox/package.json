{
  "name": "@agent-template/toolbox",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown src/skills/generate.ts --root src --format esm --no-dts",
    "lint": "oxlint --deny-warnings src",
    "skills:generate": "tsx src/skills/generate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "tsdown": {
    "fixedExtension": false
  },
  "devDependencies": {
    "@toolbox-sdk/server": ">=1.14.0",
    "vitest": ">=5.0.5"
  }
}

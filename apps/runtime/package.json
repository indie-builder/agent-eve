  "dependencies": {
    "@agent-template/agent-eve": "workspace:*",
    "@ai-sdk/anthropic": ">=4.0.82",
    "@workflow/world-postgres": ">=5.0.4",
    "ai": ">=7.0.143",
    "eve": "latest",
    "just-bash": ">=3.6.0"
  },
  "devDependencies": {
    "vitest": ">=5.0.5"
  }
}

{
  "name": "@agent-template/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma --name init",
    "db:seed": "prisma db seed --schema prisma/schema.prisma",
    "lint": "oxlint --deny-warnings src prisma.config.ts prisma/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": ">=7.10.1",
    "@prisma/client": ">=7.10.1",
    "dotenv": ">=18.0.8",
    "pg": ">=8.23.1"
  },
  "devDependencies": {
    "prisma": ">=7.10.1",
    "vitest": ">=5.0.5"
  }
}

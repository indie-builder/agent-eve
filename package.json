{
  "name": "agent-template",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @agent-template/db db:generate",
    "db:migrate": "pnpm --filter @agent-template/db db:migrate",
    "db:seed": "pnpm --filter @agent-template/db db:seed",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxfmt": ">=0.73.0 <1.0.0",
    "oxlint": "^1.88.0",
    "tsdown": ">=0.23.1 <1.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}

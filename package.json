{
  "name": "agent-template",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint && pnpm lint:e2e",
    "lint:e2e": "oxlint --deny-warnings e2e.config.ts e2e.live.config.ts tests",
    "typecheck": "turbo typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc -p tests/tsconfig.json --noEmit",
    "test": "pnpm test:contracts && pnpm test:e2e",
    "test:contracts": "turbo test",
    "test:e2e": "e2e run",
    "test:live": "e2e run --config e2e.live.config.ts",
    "db:generate": "pnpm --filter @agent-template/db db:generate",
    "db:migrate": "pnpm --filter @agent-template/db db:migrate",
    "db:seed": "pnpm --filter @agent-template/db db:seed",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@agent-template/agent": "workspace:*",
    "@agent-template/shared": "workspace:*",
    "@e2e-dev/web": ">=0.15.2",
    "@types/node": ">=26.6.5",
    "e2e": ">=0.21.2",
    "oxfmt": ">=0.73.0",
    "oxlint": ">=1.88.0",
    "tsdown": ">=0.23.1",
    "tsx": ">=4.23.15",
    "turbo": ">=2.11.9",
    "typescript": ">=7.0.2"
  }
}

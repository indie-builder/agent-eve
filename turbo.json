{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsconfig.build.json"
      ],
      "outputs": [
        ".next/**",
        "dist/**",
        ".output/**",
        ".eve/compile/**",
        ".eve/discovery/**",
        ".eve/sandbox-cache/just-bash/templates/**"
      ],
      "env": [
        "NEXT_PUBLIC_API_BASE_URL",
        "ANTHROPIC_BASE_URL",
        "ANTHROPIC_MODEL",
        "EVE_AGENT_MODEL",
        "EVE_MAX_OUTPUT_TOKENS",
        "EVE_MODEL_CONTEXT_WINDOW_TOKENS",
        "EVE_COMPACTION_THRESHOLD",
        "EVE_MAX_INPUT_TOKENS_PER_SESSION",
        "EVE_MAX_OUTPUT_TOKENS_PER_SESSION"
      ],
      "passThroughEnv": [
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_AUTH_TOKEN",
        "EVE_AGENT_SERVICE_TOKEN",
        "TOOLBOX_URL",
        "WORKFLOW_POSTGRES_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsconfig.build.json"
      ],
      "outputs": []
    },
    "@agent-template/db#build": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsconfig.build.json"
      ],
      "outputs": ["dist/**"]
    },
    "@agent-template/db#typecheck": {
      "dependsOn": ["^typecheck", "db:generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsconfig.build.json"
      ],
      "outputs": []
    },
    "@agent-template/toolbox#test": {
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/runtime/agent/connections/toolbox.ts",
        "$TURBO_ROOT$/apps/runtime/agent/skills/**"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "@agent-template/db#db:generate": {
      "outputs": ["generated/**"]
    },
    "db:migrate": {
      "cache": false
    }
  }
}

{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "dist/**",
        ".output/**",
        ".eve/compile/**",
        ".eve/discovery/**"
      ],
      "env": [
        "NEXT_PUBLIC_API_BASE_URL",
        "ANTHROPIC_BASE_URL",
        "ANTHROPIC_MODEL",
        "EVE_AGENT_MODEL",
        "EVE_MAX_OUTPUT_TOKENS",
        "EVE_MODEL_CONTEXT_WINDOW_TOKENS",
        "EVE_COMPACTION_THRESHOLD",
        "EVE_MAX_INPUT_TOKENS_PER_SESSION",
        "EVE_MAX_OUTPUT_TOKENS_PER_SESSION"
      ],
      "passThroughEnv": [
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_AUTH_TOKEN",
        "EVE_AGENT_SERVICE_TOKEN",
        "TOOLBOX_URL",
        "WORKFLOW_POSTGRES_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
